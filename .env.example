# ROOTS Travel Platform — Environment Variables Template
# Copy this to .env.local and add your real credentials

# 1. Supabase Backend (Optional)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# 2. ROOTS Lingua Live Translation Providers (Optional)
# Option A: Google Gemini API (Recommended for colloquial dialect-aware translation)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Option B: Custom / LibreTranslate API Endpoint
# VITE_TRANSLATION_API_URL=https://your-libretranslate-endpoint/translate
# VITE_TRANSLATION_API_KEY=your-optional-api-key-here
